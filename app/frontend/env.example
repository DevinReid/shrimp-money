PORT=4000

# Hardcoded User Credentials (for single-user deployments)
# Generate password hash using: node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('yourpassword', 10).then(h=>console.log(h))"
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=$2a$10$YourHashedPasswordHere

# MFA Secret (set after initial MFA setup - check logs for the encrypted value)
# ADMIN_MFA_SECRET=encrypted_secret_here
# ADMIN_MFA_ENABLED=true

# Plaid OAuth Redirect URI (optional)
# For production, set this to your production URL
# Example: https://yourdomain.com
# If not set, will be auto-detected from request headers
# PLAID_OAUTH_REDIRECT_URI=https://yourdomain.com

# Public App URL (optional)
# Used for OAuth redirects and other absolute URLs
# NEXT_PUBLIC_APP_URL=http://localhost:4000

