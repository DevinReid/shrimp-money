# Plaid API Credentials
# NOTE: Client ID is the SAME for both sandbox and production
PLAID_CLIENT_ID=your_client_id_here

# Sandbox Secret (for testing/development)
PLAID_SANDBOX_SECRET=your_sandbox_secret_here

# Production Secret (for live connections)
# Only add this when you have production access
PLAID_PRODUCTION_SECRET=your_production_secret_here

# Plaid Environment
# Set to 'sandbox' for testing, 'production' for live
# Default: sandbox
PLAID_ENV=sandbox

# Server Configuration
PORT=8000

# Authentication & Security
# Generate a strong random secret for JWT token signing
# You can generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

